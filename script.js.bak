const articles = {
  'identity-crisis': {
    meta: 'BẢN SẮC • 08 PHÚT ĐỌC',
    title: 'Khủng hoảng bản sắc cá nhân là gì?',
    body: `
      <p>Khủng hoảng bản sắc có thể được nhìn như một giai đoạn mà một người xem xét lại cách mình hiểu về bản thân: mình coi trọng điều gì, muốn trở thành ai, thuộc về đâu và những lựa chọn hiện tại có còn phù hợp hay không.</p>
      <p>Việc đặt câu hỏi về bản thân không tự động có nghĩa là “có vấn đề”. Trong các giai đoạn chuyển tiếp, khám phá có thể là một phần của quá trình hình thành và tái định hình bản sắc.</p>
      <h4>Ba câu hỏi để bắt đầu</h4>
      <ul><li>Điều gì trong cuộc sống hiện tại vẫn phù hợp với những giá trị mình coi trọng?</li><li>Điều gì mình đang làm chủ yếu vì kỳ vọng của người khác?</li><li>Nếu chưa cần có câu trả lời ngay, mình muốn khám phá điều gì trước?</li></ul>
      <p><strong>Nhắc nhỏ:</strong> cảm giác mơ hồ không phải là một chẩn đoán và cũng không nói lên toàn bộ con người bạn.</p>`,
    source: 'Nguồn nền tảng: Marcia, J. E. (1966). Development and validation of ego-identity status. DOI: 10.1037/h0023281.'
  },
  'marcia': {
    meta: 'LÝ THUYẾT • 06 PHÚT ĐỌC',
    title: '4 trạng thái bản sắc: ta đang ở đâu?',
    body: `
      <p>Mô hình trạng thái bản sắc của James Marcia thường được mô tả thông qua hai chiều cạnh: <strong>khám phá</strong> và <strong>cam kết</strong>.</p>
      <div class="modal-table"><div><b>Đạt được</b><span>Đã có quá trình khám phá và hình thành cam kết tương đối rõ.</span></div><div><b>Tạm hoãn</b><span>Đang khám phá nhiều khả năng nhưng chưa cam kết rõ.</span></div><div><b>Bị lấy mất</b><span>Có cam kết nhưng ít trải qua quá trình khám phá cá nhân.</span></div><div><b>Mơ hồ</b><span>Chưa có nhiều khám phá và cũng chưa hình thành cam kết rõ.</span></div></div>
      <p>Bốn trạng thái không nên được xem như những “nhãn người” cố định. Một người có thể khác nhau theo từng lĩnh vực của cuộc sống và có thể thay đổi theo thời gian.</p>`,
    source: 'Marcia, J. E. (1966). Development and validation of ego-identity status. Journal of Personality and Social Psychology, 3(5), 551–558. DOI: 10.1037/h0023281.'
  },
  'stress-appraisal': {
    meta: 'CĂNG THẲNG • 07 PHÚT ĐỌC',
    title: 'Vì sao cùng một áp lực, mỗi người phản ứng khác nhau?',
    body: `
      <p>Trong các mô hình giao dịch về stress và ứng phó, trải nghiệm căng thẳng không chỉ phụ thuộc vào tác nhân bên ngoài mà còn liên quan đến cách một người <strong>đánh giá</strong> tình huống và nguồn lực mình có để xử lý.</p>
      <div class="mini-flow"><span>Tình huống</span><i>→</i><span>Đánh giá</span><i>→</i><span>Nguồn lực</span><i>→</i><span>Ứng phó</span></div>
      <p>Vì vậy, hai người đối diện cùng một deadline vẫn có thể cảm nhận mức stress rất khác. Quản lý stress đôi khi là thay đổi hoàn cảnh, đôi khi là tăng nguồn lực, và đôi khi là điều chỉnh cách tiếp cận.</p>`,
    source: 'Tham khảo khái niệm: American Psychological Association — Stress.'
  },
  'students': {
    meta: 'SINH VIÊN • 09 PHÚT ĐỌC',
    title: 'Khi “mình là ai?” đi cùng “mình phải làm gì?”',
    body: `
      <p>Đời sống sinh viên có thể đặt nhiều câu hỏi lên cùng một người: chọn ngành, lựa nghề, duy trì quan hệ, theo đuổi giá trị nào và hình dung tương lai ra sao.</p>
      <p>Khi nhiều câu hỏi đến cùng lúc, ta dễ biến việc khám phá thành áp lực phải “biết ngay”. Một cách tiếp cận khác là xem mỗi trải nghiệm như một mảnh dữ liệu giúp mình hiểu rõ hơn điều phù hợp và không phù hợp.</p>
      <h4>Thử thay “phải biết” bằng “đang khám phá”</h4>
      <p>Một quyết định lớn có thể được chia thành những thử nghiệm nhỏ: tìm hiểu một lĩnh vực, tham gia dự án, nói chuyện với người có kinh nghiệm hoặc quan sát phản ứng của chính mình sau một trải nghiệm.</p>`,
    source: 'Bài viết mang tính giáo dục, diễn giải các khái niệm bản sắc và stress trong bối cảnh chuyển tiếp của sinh viên.'
  },
  'coping': {
